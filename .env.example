# Copy to .env. Never commit .env. Values here are placeholders for local use only.
#   Copy-Item .env.example .env

# --- Required by docker-compose.yml. Change these. ---
JWT_SECRET=change-me-local-only-use-at-least-32-characters
POSTGRES_PASSWORD=change-me-local-only
MINIO_ROOT_USER=workflow-local
MINIO_ROOT_PASSWORD=change-me-local-only
GRAFANA_ADMIN_PASSWORD=change-me-local-only
# GRAFANA_ADMIN_USER=admin

# --- Everything below is optional. Lines show the default. ---

# MinIO left Docker Hub. If this image cannot be pulled, point it at any S3-compatible image.
# MINIO_IMAGE=quay.io/minio/minio:RELEASE.2024-12-18T13-15-44Z

# Planner: rules (no model), auto (model, then rules if it fails or finds nothing), llm (model only).
# PLANNER_MODE=rules
# OLLAMA_BASE_URL=http://localhost:11434
# OLLAMA_MODEL=qwen3:latest
# OLLAMA_TIMEOUT_SECONDS=45

# Business defaults. Tax and payment terms are placeholders, not tax advice.
# DEFAULT_TAX_RATE=0.18
# DEFAULT_PAYMENT_TERMS_DAYS=30
# DEFAULT_CURRENCY=INR
# ALLOWED_CURRENCIES=INR,USD,EUR,GBP

# Approval policy.
# ALLOW_SELF_APPROVAL=true
# ADMIN_CAN_APPROVE=true
# APPROVAL_TTL_HOURS=72

# Demo failure simulation. Must be false in production; startup refuses otherwise.
# ENABLE_FAULT_INJECTION=false

# Retries.
# RETRY_MAX_ATTEMPTS=4
# RETRY_BASE_DELAY_SECONDS=0.5
# RETRY_MAX_DELAY_SECONDS=8
# OPERATION_TIMEOUT_SECONDS=15
# MAINTENANCE_INTERVAL_SECONDS=30

# Request limits.
# MAX_REQUEST_CHARS=4000
# MAX_BODY_BYTES=1048576
# MAX_UPLOAD_BYTES=5242880
# RATE_LIMIT_PER_MINUTE=120

# Observability. Spans are only exported when an OTLP endpoint is set.
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318/v1/traces
# LOG_LEVEL=INFO
# WORKER_METRICS_PORT=9101

# --- Set by docker-compose.yml and scripts/run_local.py. Set by hand only when running the API yourself. ---
# ENVIRONMENT=development
# DATABASE_URL=postgresql+psycopg://workflow:<password>@localhost:5432/workflow
# TASK_EXECUTOR=thread
# REDIS_URL=redis://localhost:6379/0
# STORAGE_BACKEND=local
# STORAGE_LOCAL_PATH=var/artifacts
# S3_ENDPOINT_URL=
# S3_BUCKET=workflow-artifacts
# S3_ACCESS_KEY=
# S3_SECRET_KEY=
# S3_REGION=us-east-1
# CORS_ORIGINS=http://localhost:3000
# BACKEND_URL=http://127.0.0.1:8000

# --- Required in production (ENVIRONMENT=production refuses to start without them). ---
# AUTH_MODE=oidc
# OIDC_ISSUER=
# OIDC_AUDIENCE=
# OIDC_JWKS_URL=
